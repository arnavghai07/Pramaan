# PRAMAAN environment variables.
# Copy to .env and adjust for your machine; .env itself is not committed.

# Ollama host serving the vision model (default: local install).
OLLAMA_HOST=http://localhost:11434

# Vision-language model used for Rule 6 extraction.
VLM_MODEL=qwen2.5vl:7b

# --- storage -------------------------------------------------------------
# Where the SQLite file and evidence images live (default: ./data).
# PRAMAAN_DATA_DIR=./data
# Full database URL, if you want something other than data/pramaan.db.
# PRAMAAN_DATABASE_URL=sqlite:///./data/pramaan.db

# --- authentication ------------------------------------------------------
# Secret used to sign session tokens. If unset, a random one is generated
# once and persisted to data/jwt_secret. Set it explicitly for any
# deployment beyond a local demo, and never commit the value.
# PRAMAAN_JWT_SECRET=
# How long a sign-in lasts, in hours (default 12).
# PRAMAAN_TOKEN_TTL_HOURS=12
# Set to 1 to stop the demo accounts (admin / inspector) being seeded into
# an empty database. Recommended anywhere that is not a local demo.
# PRAMAAN_DISABLE_DEMO_USERS=0
